// Tela do app Repositórios. O host preenche theme, mascot e mood; o resto vem do
// executável (src/main.rs), com {"type":"set","prop":"…","value":…}.
import { ListView } from "std-widgets.slint";
import { Theme } from "miniutils.slint";

export struct Repo {
    name: string,
    path: string,
    branch: string,
    // "1 preparado · 2 alterados · 1 novo", ou "limpo"
    changes: string,
    ahead: int,
    behind: int,
    // "há 5 h" (pendência mais velha), "agora" ou ""
    age: string,
    // conflict, stale, work, push, error, clean
    state: string,
    // "rebase em andamento · 1 no stash", ou a mensagem de erro
    note: string,
}

component Button inherits Rectangle {
    in property <Theme> theme;
    in property <string> label;
    callback clicked;
    width: max(34px, txt.preferred-width + 14px);
    height: 24px;
    background: touch.has-hover ? theme.fur.with-alpha(0.2) : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? theme.fur : theme.muted;
    txt := Text { text: label; color: theme.text; font-size: 11px; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component Main inherits Rectangle {
    in property <Theme> theme;
    in property <image> mascot;
    in property <string> mood;
    in property <string> subtitle: "iniciando…";
    in property <[Repo]> repos;
    // texto no lugar da lista quando não há repositório
    in property <string> empty;
    // "+5 repositórios limpos" (com a opção de mostrar só pendências)
    in property <string> footer;
    // nome do editor que abre a pasta ("VS Code"), ou "" se não houver
    in property <string> editor;
    callback action(string, string);

    property <bool> short: self.height < 220px;
    property <bool> narrow: self.width < 440px;

    function color-of(state: string) -> color {
        if state == "conflict" { return theme.alarm; }
        if state == "stale" { return theme.warn; }
        if state == "work" || state == "push" { return theme.fur; }
        if state == "error" { return theme.muted; }
        return theme.ok;
    }

    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Image {
                source: mascot;
                width: short ? 37px : 56px;
                height: short ? 32px : 49px;
                image-rendering: pixelated;
                image-fit: contain;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: "Repositórios"; color: theme.text; font-family: theme.font-title; font-size: short ? 15px : 17px; font-weight: 700; overflow: elide; }
                Text { text: subtitle; color: theme.sub; font-size: 12px; overflow: elide; }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    if !narrow: Button { theme: theme; label: "Pastas"; clicked => { root.action("roots", ""); } }
                    Button { theme: theme; label: "Atualizar"; clicked => { root.action("refresh", ""); } }
                }
            }
        }

        if empty != "": Text {
            text: empty;
            color: theme.sub;
            font-size: 13px;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        if empty == "": ListView {
            vertical-stretch: 1;
            for r in repos: Rectangle {
                height: 46px;
                HorizontalLayout {
                    padding-right: 8px;
                    spacing: 8px;
                    // faixa com a cor da situação
                    Rectangle { width: 3px; background: color-of(r.state); }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: r.name; color: theme.text; font-size: 14px; font-weight: 700; overflow: elide; }
                            Text { text: r.branch; color: theme.sub; font-family: theme.font-mono; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            if r.ahead > 0: Text { text: "↑" + r.ahead; color: color-of(r.state); font-family: theme.font-mono; font-size: 12px; vertical-alignment: center; }
                            if r.behind > 0: Text { text: "↓" + r.behind; color: theme.sub; font-family: theme.font-mono; font-size: 12px; vertical-alignment: center; }
                        }
                        Text {
                            text: r.changes + (r.age != "" ? " · " + r.age : "") + (r.note != "" ? " · " + r.note : "");
                            color: r.state == "clean" ? theme.sub : color-of(r.state);
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 4px;
                            Button { theme: theme; label: ">_"; clicked => { root.action("terminal", r.path); } }
                            if !narrow: Button { theme: theme; label: "Pasta"; clicked => { root.action("folder", r.path); } }
                            if !narrow && editor != "": Button { theme: theme; label: editor; clicked => { root.action("editor", r.path); } }
                        }
                    }
                }
            }
        }

        if footer != "": Text { text: footer; color: theme.muted; font-size: 11px; }
    }
}
