# Brazilian Portuguese translation of the Repositories app.
# The hub uses it for view.slint and manifest.toml; the executable embeds it for the texts
# it builds (src/i18n.rs). The test i18n::tests::catalog_covers_every_string checks that
# every text has an entry here and that no entry is unused.
msgid ""
msgstr ""
"Language: pt_BR\n"
"Content-Type: text/plain; charset=UTF-8\n"

# manifest.toml

msgid "Repositories"
msgstr "Repositórios"

msgid "Your Git repositories and what is left to commit and push, with one-click push and pull, the AI agent working in each one and the GitHub CI. The mascot nags about old pending work and celebrates when everything is pushed. Works on Linux and Windows (needs git; the CI needs gh)."
msgstr "Seus repositórios Git e o que falta commitar e enviar, com enviar e puxar num clique, o agente de IA trabalhando em cada um e o CI do GitHub. A mascote cobra pendência velha e comemora quando tudo foi enviado. Funciona no Linux e no Windows (precisa do git; o CI, do gh)."

msgid "Hours until the mascot nags about pending work"
msgstr "Horas até a mascote cobrar pendências"

msgid "Search depth in the folders"
msgstr "Profundidade da busca nas pastas"

msgid "Show only repositories with pending work"
msgstr "Mostrar só repositórios com pendências"

msgid "Fetch from the remote every 30 min (git fetch)"
msgstr "Buscar no remoto a cada 30 min (git fetch)"

msgid "Show GitHub CI and PRs (needs gh logged in)"
msgstr "Mostrar CI e PRs do GitHub (precisa do gh com login)"

msgid "Remind me at the end of the day about unpushed commits"
msgstr "Lembrar no fim do dia dos commits sem enviar"

msgid "Reminder time"
msgstr "Hora do lembrete"

